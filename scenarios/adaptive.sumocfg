<configuration>
    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="../demand/routes.rou.xml"/>
        <additional-files value="../network/detectors.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <output>
        <tripinfo-output value="../results/adaptive_tripinfo.xml"/>
        <summary-output value="../results/adaptive_summary.xml"/>
    </output>
</configuration>
